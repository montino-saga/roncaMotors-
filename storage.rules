rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Cualquier cuenta autenticada puede subir archivos.
    // El alta de usuarios se hace a mano en Firebase Auth.
    function esAdmin() {
      return request.auth != null;
    }

    // Lector no sube nada. Lee el rol de Firestore; debe coincidir con
    // puedeEscribir() de firestore.rules.
    function puedeEscribir() {
      let perfil = /databases/(default)/documents/usuarios/$(request.auth.uid);
      return esAdmin()
        && !(firestore.exists(perfil) && firestore.get(perfil).data.rol == 'lector');
    }

    // Imágenes de productos: lectura pública (catálogo web),
    // escritura sin lector, con tope de tamaño y solo imágenes.
    match /productos/{imagen} {
      allow read: if true;
      allow write: if puedeEscribir()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Cualquier otra ruta del bucket: cerrada.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
