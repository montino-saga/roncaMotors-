rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Cualquier cuenta autenticada puede subir archivos.
    // El alta de usuarios se hace a mano en Firebase Auth.
    function esAdmin() {
      return request.auth != null;
    }

    // Imágenes de productos: lectura pública (catálogo web),
    // escritura solo admin, con tope de tamaño y solo imágenes.
    match /productos/{imagen} {
      allow read: if true;
      allow write: if esAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Cualquier otra ruta del bucket: cerrada.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
