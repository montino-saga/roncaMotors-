rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Panel admin: cualquier cuenta autenticada.
    // El alta de usuarios se hace a mano en Firebase Auth, por eso no hay
    // whitelist aquí: el registro público debe estar deshabilitado en la consola.
    function esAdmin() {
      return request.auth != null;
    }

    function perfilPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    // Lector: ve todo, no escribe nada. Sin doc de perfil cuenta como admin
    // (rol inicial). Debe coincidir con puedeEscribir() de src/lib/usuarios.js.
    function puedeEscribir() {
      return esAdmin() && !(exists(perfilPath()) && get(perfilPath()).data.rol == 'lector');
    }

    // Única diferencia entre desarrollador y admin: gestionar usuarios.
    // Debe coincidir con esDesarrollador() de src/lib/usuarios.js.
    function esDesarrollador() {
      return esAdmin() && exists(perfilPath()) && get(perfilPath()).data.rol == 'desarrollador';
    }

    function cambiaRol() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']);
    }

    // Validación del pedido web (lo crea la landing pública sin cuenta).
    function pedidoWebValido() {
      let d = request.resource.data;
      return d.productos is list
        && d.productos.size() > 0
        && d.productos.size() <= 100
        && d.totalVenta is number
        && d.totalVenta >= 0
        && d.totalVenta <= 100000000
        // Estado: si viene, solo puede ser 'pendiente' (el admin lo cambia después).
        && (!('estado' in d) || d.estado == 'pendiente')
        // Tipo de pago: si viene, debe ser un string corto.
        && (!('tipoPago' in d) || (d.tipoPago is string && d.tipoPago.size() <= 30))
        // Datos del cliente: si vienen, strings con tamaño acotado.
        && (!('cliente' in d) || (
          d.cliente is map
          && (!('nombre' in d.cliente) || (d.cliente.nombre is string && d.cliente.nombre.size() <= 120))
          && (!('email' in d.cliente) || (d.cliente.email is string && d.cliente.email.size() <= 120))
          && (!('telefono' in d.cliente) || (d.cliente.telefono is string && d.cliente.telefono.size() <= 30))
        ));
    }

    match /productos/{id} {
      // Si la landing pública necesitara leer
      // el catálogo desde esta base, cambia read a: allow read: if true;
      allow read: if esAdmin();
      allow write: if puedeEscribir();
    }

    match /clients/{id} {
      allow read: if esAdmin();
      allow write: if puedeEscribir();
      match /movements/{mid} {
        allow read: if esAdmin();
        allow write: if puedeEscribir();
      }
    }

    // Caché de consultas de patente: solo la escribe la Cloud Function (Admin SDK).
    match /vehiculos/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    match /sales/{id} {
      allow read: if esAdmin();
      allow write: if puedeEscribir();
    }

    match /cash_registers/{id} {
      allow read: if esAdmin();
      allow write: if puedeEscribir();
    }

    match /gastos/{id} {
      allow read: if esAdmin();
      allow write: if puedeEscribir();
    }

    // Pedidos del local (encargos de clientes con abono).
    match /pedidos/{id} {
      allow read: if esAdmin();
      allow write: if puedeEscribir();
    }

    // Gastos fijos: plantillas que la app usa para registrar un gasto cada mes.
    match /gastosRecurrentes/{id} {
      allow read: if esAdmin();
      allow write: if puedeEscribir();
    }

    // Perfil y rol de cada cuenta (id = uid de Auth).
    // Cada uno lee y registra su propio acceso (AuthContext); el resto, solo desarrollador.
    match /usuarios/{uid} {
      allow read: if esAdmin() && (request.auth.uid == uid || esDesarrollador());
      // Alta propia solo como admin: nadie se autoasigna desarrollador.
      allow create: if esAdmin() && request.auth.uid == uid && request.resource.data.rol == 'admin';
      // Nadie cambia su propio rol: un desarrollador no puede quedarse sin acceso por error.
      allow update: if esAdmin() && (
        (request.auth.uid == uid && !cambiaRol())
        || (request.auth.uid != uid && esDesarrollador())
      );
      allow delete: if esDesarrollador() && request.auth.uid != uid;
    }

    match /settings/{id} {
      allow read: if esAdmin();
      allow write: if puedeEscribir();
    }

    // Pedidos web: crear abierto con validación; leer/editar/borrar solo admin.
    match /salesWeb/{id} {
      allow read: if esAdmin();
      allow update, delete: if puedeEscribir();
      allow create: if pedidoWebValido();
    }

    // Todo lo demás: cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
